# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Yandex AI Studio через OpenAI-совместимый API
YANDEX_API_KEY=your_yandex_api_key
YANDEX_FOLDER_ID=your_folder_id
YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEXGPT_MODEL=gpt://your_folder_id/yandexgpt/latest
YANDEX_EMBEDDING_MODEL=emb://your_folder_id/text-search-doc/latest
YANDEX_QUERY_EMBEDDING_MODEL=emb://your_folder_id/text-search-query/latest

# ChromaDB
CHROMA_COLLECTION=assistant_memory
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# Память и ответы
MEMORY_CONTEXT_SIZE=5
MEMORY_SEARCH_CANDIDATES=5
MEMORY_MAX_DISTANCE=0.8
MEMORY_MIN_CONFIDENCE=0.7
# Количество последних пар «пользователь — бот» для понимания неполных фраз
MEMORY_RECENT_TURNS=3
LOG_LEVEL=INFO
